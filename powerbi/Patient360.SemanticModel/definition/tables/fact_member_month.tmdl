/// One row per patient per month of insurance coverage.
table fact_member_month
	lineageTag: 16444972-d590-5ae3-bfdc-1a36f2acedf3

	column patient_id
		dataType: string
		lineageTag: 5364a2eb-7831-59fc-9f77-db06dfa380bb
		summarizeBy: none
