	column base_cost
		dataType: decimal
		formatString: \$#,0.00
		lineageTag: f6434bf7-6792-5c77-bbf5-40e23d7e87c6
		summarizeBy: none
		sourceColumn: base_cost

	partition fact_procedure = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(DatabricksServerHostname, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    healthcare = Source{[Name = "healthcare", Kind = "Database"]}[Data],
				    gold = healthcare{[Name = "gold", Kind = "Schema"]}[Data],
				    fact_procedure = gold{[Name = "fact_procedure", Kind = "Table"]}[Data]
				in
				    fact_procedure
